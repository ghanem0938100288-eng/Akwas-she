        await update.message.reply_text("✅ تم تحديث نص رسالة نقاط الولاء بنجاح.")
        context.user_data.clear()
        return

    elif state == "WAIT_ADMIN_GIVE_GIFT_UID":
        if not text.isdigit():
            await update.message.reply_text("أدخل معرف صحيح باللغة الانكليزية:")
            return
        context.user_data["gift_uid"] = int(text)
        context.user_data["state"] = "WAIT_ADMIN_GIVE_GIFT_AMT"
        await update.message.reply_text("ادخل المبلغ المراد اهدائه:")
        return

    elif state == "WAIT_ADMIN_GIVE_GIFT_AMT":
        if not text.isdigit():
            await update.message.reply_text("أدخل مبلغ صحيح:")
            return
        amt = int(text)
        uid = context.user_data.get("gift_uid")
        if uid in users:
            users[uid]["balance"] += amt
            if uid not in gifts_history:
                gifts_history[uid] = []
            gifts_history[uid].append({"amount": amt, "date": str(datetime.datetime.now())[:19]})
            save_data()
            await update.message.reply_text(f"✅ تم منح الهدية للمستخدم بنجاح بمبلغ {amt}")
            try:
                await context.bot.send_message(chat_id=uid, text=f"- 🎉🤩 تم منحك كود هدية بقيمة {amt}\n- يرجى صرفه من القائمة.")
            except Exception:
                pass
        else:
            await update.message.reply_text("❌ المستخدم غير موجود في قاعدة بيانات البوت.")
        context.user_data.clear()
        return

    if state == "WAIT_ECH_USER":
        if not re.match(r'^[a-zA-Z]+$', text):
            await update.message.reply_text("❌ اسم مستخدم غير صحيح (باللغة الإنجليزية فقط بدون أرقام أو مسافات)، أعد الإدخال:")
            return
        user_counter += 1
        context.user_data["temp_ech_user"] = f"{text}{user_counter:04d}"
        context.user_data["state"] = "WAIT_ECH_PASS"
        save_data()
        await update.message.reply_text("ادخل كلمة مرور (8 أرقام وأحرف باللغة الإنجليزية أو أكثر):")
        return
        
    elif state == "WAIT_ECH_PASS":
