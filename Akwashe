async def global_message_handler(update: Update, context: ContextTypes.DEFAULT_TYPE):
    global user_counter, request_counter
    user_id = update.effective_user.id
    state = context.user_data.get("state")
    
    if context.user_data.get("waiting_for_grant_target"):
        await process_admin_grant_wheel(update, context)
        return

    if state == "WAIT_ADMIN_CB_VALS":
        text = update.message.text.strip()
        try:
            parts = text.split()
            min_dep = float(parts[0])
            rate_val = float(parts[1]) / 100.0
            settings["cashback_min_deposit"] = min_dep
            settings["cashback_rate"] = rate_val
            save_data()
            await update.message.reply_text(f"✅ تم تحديث إعدادات الكاش باك بنجاح:\nالحد الأدنى اليومي: {min_dep}\nالنسبة: {int(rate_val*100)}%")
        except Exception:
            await update.message.reply_text("❌ خطأ في الإدخال. يرجى الإرسال هكذا: `500 10`", parse_mode='Markdown')
        context.user_data.clear()
        return

    if state == "WAIT_ADMIN_WB_VAL":
        text = update.message.text.strip()
        try:
            rate_val = float(text) / 100.0
            settings["welcome_bonus_rate"] = rate_val
            save_data()
            await update.message.reply_text(f"✅ تم تحديث نسبة البونص الترحيبي بنجاح إلى: {text}%")
        except Exception:
            await update.message.reply_text("❌ يرجى إدخال رقم صحيح (مثال: `20`)", parse_mode='Markdown')
        context.user_data.clear()
        return

    if context.user_data.get("admin_replying_to_user"):
        target_uid = context.user_data.pop("admin_replying_to_user")
        reply_text = update.message.text.strip()
        try:
            await context.bot.send_message(
                chat_id=target_uid,
                text=f"📬 **رد من إدارة البوت:**\n\n{reply_text}"
            )
            await update.message.reply_text("✅ تم إرسال الرد للمستخدم بنجاح.")
        except Exception as e:
            await update.message.reply_text(f"❌ لم يتم إرسال الرد، حدث خطأ: {e}")
        context.user_data.clear()
        return
        
    if not state:
        return 
        
    if state == "WAIT_ADMIN_BROADCAST_MSG":
        success_count = 0
        for uid in users.keys():
            try:
                await context.bot.copy_message(
                    chat_id=uid,
                    from_chat_id=update.effective_chat.id,
                    message_id=update.message.message_id
                )
                success_count += 1
            except Exception:
                pass
        await update.message.reply_text(f"✅ تم إرسال الإذاعة بنجاح إلى ({success_count}) مستخدم.")
        context.user_data.clear()
        return

    text = update.message.text.strip() if update.message.text else ""

    if state == "WAIT_ADMIN_MANAGE_ID":
        if not text.isdigit():
            await update.message.reply_text("أدخل معرف صحيح باللغة الانكليزية:")
            return
        uid = int(text)
        if uid == SUPER_ADMIN_ID:
            await update.message.reply_text("لا يمكن تعديل حالة الأدمن الأساسي.")
            context.user_data.clear()
            return
        if uid in admins:
            admins.remove(uid)
            save_data()
            await update.message.reply_text(f"✅ تم إزالة المستخدم `{uid}` من الأدمنية بنجاح.")
        else:
            admins.append(uid)
            save_data()
            await update.message.reply_text(f"✅ تم إضافة المستخدم `{uid}` إلى الأدمنية بنجاح.")
        context.user_data.clear()
        return

    elif state == "WAIT_ADMIN_ADD_CODE_NUM":
        ctype = context.user_data.get("code_type")
        if ctype == "syr":
            settings["syriatel_numbers"].append(text)
        elif ctype == "mtn":
            settings["mtn_numbers"].append(text)
        elif ctype == "sham":
            settings["sham_accounts"].append(text)
        save_data()
        await update.message.reply_text("✅ تمت إضافة الرقم/الحساب بنجاح.")
        context.user_data.clear()
        return

    elif state == "WAIT_ADMIN_REM_CODE_NUM":
        ctype = context.user_data.get("code_type")
        if ctype == "syr" and text in settings["syriatel_numbers"]:
            settings["syriatel_numbers"].remove(text)
        elif ctype == "mtn" and text in settings["mtn_numbers"]:
            settings["mtn_numbers"].remove(text)
        elif ctype == "sham" and text in settings["sham_accounts"]:
            settings["sham_accounts"].remove(text)
        save_data()
        await update.message.reply_text("✅ تم إزالة الرقم/الحساب بنجاح.")
        context.user_data.clear()
        return

    elif state == "WAIT_ADMIN_LUCK_VAL":
        new_luck = [x.strip() for x in text.split(",") if x.strip()]
        if not new_luck:
            await update.message.reply_text("أدخل قيمة صحيحة مفصولة بفواصل:")
            return
        settings["luck_endings"] = new_luck
        save_data()
        await update.message.reply_text(f"✅ تم تحديث أرقام حظك والكاش بنجاح إلى: {', '.join(new_luck)}")
        context.user_data.clear()
        return

    elif state == "WAIT_ADMIN_USER_BAL_AMT":
        if not text.isdigit():
            await update.message.reply_text("أدخل مبلغ صحيح:")
            return
        amt = int(text)
        uid = context.user_data.get("target_user_id")
        action = context.user_data.get("target_action")
        if uid in users:
            if action == "dep":
                users[uid]["balance"] += amt
                await update.message.reply_text(f"✅ تم شحن رصيد المستخدم `{uid}` بمبلغ {amt} بنجاح.")
                try:
                    await context.bot.send_message(chat_id=uid, text=f"✅ تمت إضافة مبلغ {amt} إلى رصيدك من قبل الإدارة.")
                except Exception:
                    pass
            else:
                users[uid]["balance"] -= amt
                await update.message.reply_text(f"✅ تم خصم مبلغ {amt} من رصيد المستخدم `{uid}` بنجاح.")
                try:
                    await context.bot.send_message(chat_id=uid, text=f"⚠️ تم خصم مبلغ {amt} من رصيدك من قبل الإدارة.")
                except Exception:
                    pass
            save_data()
        else:
            await update.message.reply_text("❌ المستخدم غير موجود.")
        context.user_data.clear()
        return

    elif state == "WAIT_ADMIN_BONUS_VAL":
        if not text.replace('.', '', 1).isdigit():
            await update.message.reply_text("أدخل قيمة صحيحة:")
            return
        val = float(text) / 100.0
        target = context.user_data.get("bonus_target")
        target_name = context.user_data.get("bonus_target_name", "الطريقة المختارة")
        current_val = settings["bonus_syriatel_mtn"] if target == "syr_mtn" else settings["bonus_sham"]
        if target == "syr_mtn":
            settings["bonus_syriatel_mtn"] = val
        else:
            settings["bonus_sham"] = val
        save_data()
        if val > current_val:
            broadcast_text = f"انطلق ياملك 🤩🤩\nتم تعديل بونص الشحن عن طريق {target_name} ليصبح {text}%"
            for uid in users.keys():
                try:
                    await context.bot.send_message(chat_id=uid, text=broadcast_text)
                except Exception:
                    pass
        await update.message.reply_text(f"✅ تم تحديث نسبة البونص بنجاح إلى {text}%")
        context.user_data.clear()
        return

    elif state == "WAIT_ADMIN_MIN_WITH_VAL":
        if not text.isdigit():
            await update.message.reply_text("أدخل رقم صحيح:")
            return
        val = int(text)
        target = context.user_data.get("min_with_target")
        settings["min_withdraw"][target] = val
        save_data()
        await update.message.reply_text(f"✅ تم تحديث الحد الأدنى للسحب بنجاح إلى: {val}")
        context.user_data.clear()
        return

    elif state == "WAIT_ADMIN_RATE":
        if not text.isdigit():
            await update.message.reply_text("أدخل رقم صحيح:")
            return
        settings["dollar_rate"] = int(text)
        save_data()
        await update.message.reply_text(f"✅ تم تعديل سعر الدولار بنجاح إلى: {text}")
        context.user_data.clear()
        return

    elif state == "WAIT_ADMIN_OFFERS_TEXT":
        settings["offers_text"] = text
        save_data()
        await update.message.reply_text("✅ تم تحديث نص رسالة العروض بنجاح.")
        context.user_data.clear()
        return

    elif state == "WAIT_ADMIN_LOYALTY_TEXT":
        settings["loyalty_info_text"] = text
