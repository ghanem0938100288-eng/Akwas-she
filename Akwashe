def save_data():
    data = {
        "admins": admins,
        "settings": settings,
        "users": users,
        "pending_requests": pending_requests,
        "used_tx_ids": list(used_tx_ids),
        "deposit_history": deposit_history,
        "withdraw_history": withdraw_history,
        "gifts_history": gifts_history,
        "user_counter": user_counter,
        "request_counter": request_counter
    }
    try:
        with open(DB_FILE, "w", encoding="utf-8") as f:
            json.dump(data, f, ensure_ascii=False, indent=4)
    except Exception as e:
        logging.error(f"Error saving DB: {e}")

def load_data():
    global admins, settings, users, pending_requests, used_tx_ids
    global deposit_history, withdraw_history, gifts_history, user_counter, request_counter
    
    if os.path.exists(DB_FILE):
        try:
            with open(DB_FILE, "r", encoding="utf-8") as f:
                data = json.load(f)
                admins = data.get("admins", [SUPER_ADMIN_ID])
                loaded_settings = data.get("settings", {})
                for k, v in loaded_settings.items():
                    settings[k] = v
                users = {int(k): v for k, v in data.get("users", {}).items()}
                pending_requests = {int(k): v for k, v in data.get("pending_requests", {}).items()}
                used_tx_ids = set(data.get("used_tx_ids", []))
                deposit_history = {int(k): v for k, v in data.get("deposit_history", {}).items()}
                withdraw_history = {int(k): v for k, v in data.get("withdraw_history", {}).items()}
                gifts_history = {int(k): v for k, v in data.get("gifts_history", {}).items()}
                user_counter = data.get("user_counter", 0)
                request_counter = data.get("request_counter", 1000)
            logging.info("DB loaded successfully.")
        except Exception as e:
            logging.error(f"Error reading DB: {e}")

