async def wheel_menu(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if await check_maintenance(update, context):
        return
    query = update.callback_query
    await query.answer()
    
    user_id = query.from_user.id
    int_uid = int(user_id)
    
    if int_uid not in users:
        users[int_uid] = {
            "balance": 0.0, 
            "loyalty_points": 0, 
            "today_deposit": 0, 
            "total_today_bot_deposit": 0,
            "today_echancy_deposit": 0,
            "last_spin": "",
            "accepted_terms": True
        }
        
    today_str = datetime.date.today().isoformat()
    if users[int_uid].get("last_deposit_date") != today_str:
        users[int_uid]["total_today_bot_deposit"] = 0
        users[int_uid]["today_deposit"] = 0
        users[int_uid]["today_echancy_deposit"] = 0
        users[int_uid]["last_deposit_date"] = today_str

    today_dep = users[int_uid].get("total_today_bot_deposit", 0)
    has_admin_bonus = users[int_uid].get("admin_extra_spin", False)
    
    can_spin = "1"
    reason = "ok"
    prize_amount = 0
    
    if users[int_uid].get("last_spin") == today_str and not has_admin_bonus:
        can_spin = "0"
        reason = "used"
    elif today_dep < 100 and not has_admin_bonus:
        can_spin = "0"
        reason = "no_deposit"
    else:
        if has_admin_bonus:
            prize_amount = users[int_uid].get("admin_bonus_amount", 50)
            users[int_uid]["admin_extra_spin"] = False
        else:
            if 100 <= today_dep <= 499:
                prize_amount = 10
            elif 500 <= today_dep <= 999:
                prize_amount = 20
            elif 1000 <= today_dep <= 1499:
                prize_amount = 50
            elif today_dep >= 1500:
                prize_amount = 100
                
        users[int_uid]["last_spin"] = today_str
        if prize_amount > 0:
            users[int_uid]["balance"] = users[int_uid].get("balance", 0.0) + prize_amount
        save_data()

    base_web_url = f"https://ghanem0938100288-eng.github.io/Ghanem100/?can_spin={can_spin}&reason={reason}&prize={prize_amount}"
    
    kb = [
        [InlineKeyboardButton("فتح عجلة الحظ 🎡", web_app=WebAppInfo(url=base_web_url))],
        [InlineKeyboardButton("رجوع ↪️", callback_data='main_menu')]
    ]
    
    msg = (
        "🎡 **عجلة الحظ التفاعلية**\n\n"
        "اضغط على الزر أدناه لفتح العجلة وتدويرها للحصول على جوائزك الفورية! 🌟\n"
        "*(ملاحظة: يتطلب فرصة واحدة يومياً شحن مبلغ لا يقل عن 100)*"
    )
    
    try:
        await query.message.delete()
    except Exception:
        pass
    await query.message.reply_text(msg, reply_markup=InlineKeyboardMarkup(kb), parse_mode='Markdown')

