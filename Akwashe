async def process_admin_grant_wheel(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if update.effective_user.id not in admins:
        return
    if not context.user_data.get("waiting_for_grant_target"):
        return
    
    text = update.message.text.strip()
    try:
        parts = text.split()
        target_id = int(parts[0])
        bonus_val = float(parts[1])
        
        if target_id not in users:
            users[target_id] = {"balance": 0.0, "loyalty_points": 0, "today_deposit": 0, "total_today_bot_deposit": 0, "today_echancy_deposit": 0, "icash_deposited_today": False}
            
        users[target_id]["admin_extra_spin"] = True
        users[target_id]["admin_bonus_amount"] = bonus_val
        save_data()
        
        context.user_data.pop("waiting_for_grant_target", None)
        await update.message.reply_text(f"✅ تم منح المستخدم `{target_id}` فرصة عجلة الحظ بقيمة جائزة `{bonus_val}` بنجاح!")
    except Exception:
        await update.message.reply_text("❌ خطأ في الإدخال. يجب الإرسال هكذا: `ID المبلغ` مثل: `12345678 50`", parse_mode='Markdown')

