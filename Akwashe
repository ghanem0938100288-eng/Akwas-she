async def check_maintenance(update: Update, context: ContextTypes.DEFAULT_TYPE) -> bool:
    user = update.effective_user
    if not user:
        return False
    if settings.get("maintenance_mode", False) and user.id not in admins:
        msg = (
            "البوت يخضع الصيانة🔧 سيتم العودة للعمل قريبا نعتذر عن اجراء أي عمليات داخل البوت وجميع العمليات القائمة ستتم محفوظة حتى تنتهي الصيانة .\n"
            "شكرا لتفهمكم🙏🙏"
        )
        if update.callback_query:
            await update.callback_query.answer()
            try:
                await update.callback_query.message.delete()
            except Exception:
                pass
            await update.callback_query.message.reply_text(msg)
        elif update.message:
            await update.message.reply_text(msg)
        return True
    return False

