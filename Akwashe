def get_current_third_of_month():
    now = datetime.datetime.now()
    day = now.day
    if day <= 10:
        return 1
    elif day <= 20:
        return 2
    else:
        return 3

async def loyalty_do_exchange(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if await check_maintenance(update, context):
        return
    global request_counter
    query = update.callback_query
    await query.answer()
    user_id = query.from_user.id
    last_ex = users[user_id].get("last_loyalty_exchange")
    current_third = get_current_third_of_month()
    now_str = f"{datetime.datetime.now().strftime('%Y-%m')}-3rd-{current_third}"
    try:
        await query.message.delete()
    except Exception:
        pass
    if last_ex == now_str:
        await query.message.reply_text("لا يمكن استبدال النقاط خلال الثلث الحالي من الشهر", reply_markup=InlineKeyboardMarkup([[InlineKeyboardButton("رجوع", callback_data='btn_loyalty')]]))
        return
    points = users[user_id].get("loyalty_points", 0)
    if points < 200:
        await query.message.reply_text("عدد نقاط غير كافي", reply_markup=InlineKeyboardMarkup([[InlineKeyboardButton("رجوع", callback_data='btn_loyalty')]]))
        return
    tiers = settings.get("loyalty_tiers", [])
    selected_tier = None
    for tier in tiers:
        if points >= tier["points"]:
            selected_tier = tier
            break
    if not selected_tier:
        await query.message.reply_text("عدد نقاط غير كافي", reply_markup=InlineKeyboardMarkup([[InlineKeyboardButton("رجوع", callback_data='btn_loyalty')]]))
        return
    req_pts = selected_tier["points"]
    desc = selected_tier["desc"]
    users[user_id]["last_loyalty_exchange"] = now_str
    request_counter += 1
    req_id = request_counter
    pending_requests[req_id] = {
        "type": "loyalty_exchange",
        "user_id": user_id,
        "points": req_pts,
        "reward_desc": desc
    }
    save_data()
    await query.message.reply_text(f"تهانينا سيتم استبدال نقاطك بهدية ({desc})\nتم رفع الطلب للإدارة سيتم اعلامك حين الموافقة وإضافة الهدية إلى رصيدك بالبوت .")
    admin_kb = InlineKeyboardMarkup([
        [InlineKeyboardButton("موافقة ✅", callback_data=f"app_dep_{req_id}"), InlineKeyboardButton("رفض ❌", callback_data=f"rej_{req_id}")],
        [InlineKeyboardButton("رد برسالة ✍️", callback_data=f"reply_user_{req_id}_{user_id}")]
    ])
    await context.bot.send_message(chat_id=SUPER_ADMIN_ID, text=f"🎁 **طلب تبديل نقاط ولاء #{req_id}**\n👤 المعرف: `{user_id}`\n🔷 النقاط المخصومة: {req_pts}\n🎁 الجائزة: {desc}", reply_markup=admin_kb, parse_mode='Markdown')

