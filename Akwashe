        return

    elif state == "WAIT_DEP_AMT":
        if not re.match(r'^\d+(\.\d+)?$', text):
            await update.message.reply_text("❌ أدخل مبلغاً صحيحاً:")
            return
        amt = float(text)
        method = context.user_data.get("dep_method", "")
        if "USD" not in method and amt < 50:
            await update.message.reply_text("❌ أقل قيمة للشحن هي 50، أعد الإدخال:")
            return
        context.user_data["dep_amt"] = amt
        context.user_data["state"] = "WAIT_DEP_TX"
        kb = InlineKeyboardMarkup([[InlineKeyboardButton("رجوع", callback_data='btn_deposit_bot')]])
        if "شام" in method:
            await update.message.reply_text("أدخل رقم العملية المكون من 8 أو 9 أرقام 👇", reply_markup=kb)
        else:
            await update.message.reply_text("أدخل رقم عملية الدفع 👇", reply_markup=kb)
        return

    elif state == "WAIT_DEP_TX":
        tx_id = text
        method = context.user_data.get("dep_method", "")
        valid = (tx_id.isdigit() and len(tx_id) in [8, 9]) if "شام" in method else (tx_id.isdigit() and len(tx_id) == 12)
        if not valid or tx_id in used_tx_ids:
            await update.message.reply_text("❌ رقم العملية غير صحيح أو مستخدم مسبقاً، أعد الإدخال:")
            return
        amt = context.user_data.get("dep_amt")
        if "USD" in method:
            amt = amt * settings.get("dollar_rate", 13500)
        request_counter += 1
        req_id = request_counter
        pending_requests[req_id] = {
            "type": "deposit_bot",
            "user_id": user_id,
            "method": method,
            "amount": amt,
            "tx_id": tx_id
        }
        context.user_data.clear()
        save_data()
        await update.message.reply_text("جاري معالجة طلبك الرجاء الانتظار")
        admin_kb = InlineKeyboardMarkup([
            [InlineKeyboardButton("موافقة ✅", callback_data=f"app_dep_{req_id}"), InlineKeyboardButton("رفض ❌", callback_data=f"rej_{req_id}")],
            [InlineKeyboardButton("رد برسالة ✍️", callback_data=f"reply_user_{req_id}_{user_id}")]
        ])
        await context.bot.send_message(chat_id=SUPER_ADMIN_ID, text=f"📥 **طلب شحن رصيد بالبوت #{req_id}**\n👤 المعرف: `{user_id}`\n💳 الطريقة: {method}\n💰 المبلغ: {amt}\n🔢 رقم العملية: `{tx_id}`", reply_markup=admin_kb, parse_mode='Markdown')
        return

    elif state == "WAIT_WITH_PHONE":
        if not (text.isdigit() and len(text) == 10):
            await update.message.reply_text("❌ أدخل رقم هاتف صحيح مكون من 10 أرقام:")
            return
        context.user_data["with_phone"] = text
        method = context.user_data.get("with_method")
        kb = InlineKeyboardMarkup([[InlineKeyboardButton("رجوع", callback_data='btn_withdraw_bot')]])
        if method in ["الهرم", "الفؤاد"]:
            context.user_data["state"] = "WAIT_WITH_NAME"
            await update.message.reply_text("ثانياً: أدخل الاسم الثلاثي للمستفيد 👇", reply_markup=kb)
        else:
            context.user_data["state"] = "WAIT_WITH_AMT"
            await update.message.reply_text("ثانياً: أدخل مبلغ السحب 👇", reply_markup=kb)
        return

    elif state == "WAIT_WITH_NAME":
        if len(text.split()) < 3:
            await update.message.reply_text("❌ يجب إدخال الاسم الثلاثي الصحيح:")
            return
        context.user_data["with_name"] = text
        context.user_data["state"] = "WAIT_WITH_AMT"
        kb = InlineKeyboardMarkup([[InlineKeyboardButton("رجوع", callback_data='btn_withdraw_bot')]])
        await update.message.reply_text("ثالثاً : أدخل مبلغ السحب 👇", reply_markup=kb)
        return

    elif state == "WAIT_WITH_AMT":
        if not re.match(r'^\d+$', text):
            await update.message.reply_text("❌ أدخل مبلغاً صحيحاً:")
            return
        amt = int(text)
        bal = users[user_id]["balance"]
        min_amt = context.user_data.get("min_amt", 250)
        method = context.user_data.get("with_method")
        if amt < min_amt or amt > bal:
            await update.message.reply_text(f"❌ المبلغ غير مناسب (أقل حد هو {min_amt} ولا يتجاوز رصيدك)، أعد الإدخال:")
            return
        context.user_data["with_amt"] = amt
        kb = InlineKeyboardMarkup([[InlineKeyboardButton("رجوع", callback_data='btn_withdraw_bot')]])
        if method == "شام كاش":
            context.user_data["state"] = "WAIT_WITH_SHAM_ACC"
            await update.message.reply_text("ثالثا: أدخل رقم حساب شام كاش الخاص بك 👇", reply_markup=kb)
            return
        else:
            await finalize_withdraw_global(update, context, user_id)
        return

    elif state == "WAIT_WITH_SHAM_ACC":
        if not re.match(r'^[a-zA-Z0-9]+$', text):
            await update.message.reply_text("❌ يرجى إدخال رقم حساب شام كاش صحيح:")
            return
        context.user_data["with_sham_acc"] = text
        await finalize_withdraw_global(update, context, user_id)
        return

    elif state == "WAIT_GIFT_CODE":
        gift_codes_db = settings.get("gift_codes", {})
        if text in gift_codes_db and not gift_codes_db[text]["used"]:
            amt = gift_codes_db[text]["amount"]
            gift_codes_db[text]["used"] = True
            users[user_id]["balance"] += amt
            if user_id not in gifts_history:
                gifts_history[user_id] = []
            gifts_history[user_id].append({"amount": amt, "date": str(datetime.datetime.now())[:19]})
            context.user_data.clear()
            save_data()
            await update.message.reply_text(f"- تهانينا لقد تم اهداءك رصيد للبوت بقيمة {amt}")
        else:
            await update.message.reply_text("❌ الكود غير صالح أو تم استخدامه مسبقاً. أعد الإدخال:")
        return

async def finalize_withdraw_global(update: Update, context: ContextTypes.DEFAULT_TYPE, user_id: int):
    global request_counter
    amt = context.user_data.get("with_amt")
    method = context.user_data.get("with_method")
    phone = context.user_data.get("with_phone")
    name = context.user_data.get("with_name", "")
    sham_acc = context.user_data.get("with_sham_acc", "")
    net_amt = amt * 0.9  
    request_counter += 1
    req_id = request_counter
    pending_requests[req_id] = {
        "type": "withdraw_bot",
        "user_id": user_id,
        "method": method,
        "amount": amt,
        "net_amount": net_amt,
        "phone": phone,
        "name": name,
        "sham_acc": sham_acc
    }
    context.user_data.clear()
    save_data()
    destination = sham_acc if sham_acc else phone
    user_text = (
        f"- مبلغ السحب : {amt}\n"
        f"- المبلغ بعد الاقتطاع : {net_amt}\n"
        + (f"-الاسم الثلاثي : {name}\n" if name else "") +
        f"- رقم الهاتف/الحساب : {destination}\n"
        f"- حالة الطلب : قيد المعالجة."
    )
    await update.message.reply_text(user_text)
    admin_kb = InlineKeyboardMarkup([
        [InlineKeyboardButton("موافقة ✅", callback_data=f"app_dep_{req_id}"), InlineKeyboardButton("رفض ❌", callback_data=f"rej_{req_id}")],
        [InlineKeyboardButton("رد برسالة ✍️", callback_data=f"reply_user_{req_id}_{user_id}")]
    ])
    await context.bot.send_message(chat_id=SUPER_ADMIN_ID, text=f"📤 **طلب سحب رصيد من البوت #{req_id}**\n👤 المعرف: `{user_id}`\n💳 الطريقة: {method}\n💰 المبلغ: {amt} (صافي: {net_amt})\n📞 الوجهة: `{destination}`", reply_markup=admin_kb, parse_mode='Markdown')

async def admin_callbacks(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    data = query.data
    
    if data.startswith("reply_user_"):
        parts = data.split("_")
        target_user_id = int(parts[3])
        context.user_data["admin_replying_to_user"] = target_user_id
        await query.message.reply_text("✍️ أرسل الآن نص الرد الذي تريد إرساله للمستخدم:")
        return

    if data.startswith("app_") or data.startswith("rej_"):
        parts = data.split("_")
        action = parts[0]
        req_id = int(parts[-1])
        if req_id in pending_requests:
            req = pending_requests.pop(req_id)
            user_id = req["user_id"]
            if action == "app":
                if req["type"] == "deposit_bot":
                    amt = req["amount"]
                    method = req["method"]
                    bonus_rate = settings["bonus_sham"] if "شام" in method else settings["bonus_syriatel_mtn"]
                    
                    welcome_bonus_text = ""
                    if settings.get("welcome_bonus_enabled", True) and not users[user_id].get("first_deposit_done", False):
                        wb_rate = settings.get("welcome_bonus_rate", 0.20)
                        bonus_rate += wb_rate
                        users[user_id]["first_deposit_done"] = True
                        welcome_bonus_text = f"\n🎉 مبروك! حصلت على البونص الترحيبي لأول شحن بنسبة {int(wb_rate*100)}%"

                    bonus = amt * bonus_rate
                    total_credited = amt + bonus
                    users[user_id]["balance"] += total_credited
                    
                    today_str = datetime.date.today().isoformat()
                    if users[user_id].get("last_deposit_date") != today_str:
                        users[user_id]["total_today_bot_deposit"] = 0
                        users[user_id]["today_echancy_deposit"] = 0
                        users[user_id]["last_deposit_date"] = today_str
                    users[user_id]["total_today_bot_deposit"] = users[user_id].get("total_today_bot_deposit", 0) + amt
                    users[user_id]["today_deposit"] = users[user_id]["total_today_bot_deposit"]

                    loyalty_add = int(amt // 50)
                    users[user_id]["loyalty_points"] = users[user_id].get("loyalty_points", 0) + loyalty_add
                    if user_id not in deposit_history:
                        deposit_history[user_id] = []
                    deposit_history[user_id].append({"amount": amt, "method": method, "date": str(datetime.datetime.now())[:19]})
                    used_tx_ids.add(req["tx_id"])
                    
                    tx_str = str(req["tx_id"])
                    luck_list = tuple(settings.get("luck_endings", ["11", "22", "33"]))
                    luck_bonus_text = ""
                    if tx_str.endswith(luck_list):
                        gift_val = int(amt * 0.1)
                        if gift_val < 50: gift_val = 50
                        unique_code = f"LUCK-{req_id}-{tx_str[-2:]}"
                        if "gift_codes" not in settings:
                            settings["gift_codes"] = {}
                        settings["gift_codes"][unique_code] = {"amount": gift_val, "used": False}
                        if user_id not in gifts_history:
                            gifts_history[user_id] = []
                        gifts_history[user_id].append({"amount": gift_val, "date": str(datetime.datetime.now())[:19]})
                        luck_bonus_text = f"\n\n🎁 مبروك! رقم عمليتك يحمل جائزة حظك والكاش!\n🔑 كود الهدية: `{unique_code}`"

                    save_data()
                    
                    success_msg = (
                        f"✅ نجاح\n\n"
                        f"💰 رصيدك الحالي في البوت:\n"
                        f"{users[user_id]['balance']:.2f} NSP \n\n"
                        f"💰 تمت إضافة بونص إجمالي: {int(bonus_rate*100)}%\n"
                        f"{welcome_bonus_text}\n"
                        f"⭐️ حصلت على {loyalty_add} نقاط ولاء في البوت."
                        f"{luck_bonus_text}"
                    )
                    await context.bot.send_message(chat_id=user_id, text=success_msg, parse_mode='Markdown')
                elif req["type"] == "withdraw_bot":
                    amt = req["amount"]
                    users[user_id]["balance"] -= amt
                    if user_id not in withdraw_history:
                        withdraw_history[user_id] = []
                    withdraw_history[user_id].append({"amount": amt, "net_amount": req["net_amount"], "method": req["method"], "date": str(datetime.datetime.now())[:19]})
                    save_data()
                    await context.bot.send_message(chat_id=user_id, text="-تم تنفيذ الطلب السحب بنجاح ✅")
                elif req["type"] == "create_echancy":
                    users[user_id]["ech_user"] = req["ech_user"]
                    users[user_id]["ech_pass"] = req["ech_pass"]
                    save_data()
                    await context.bot.send_message(chat_id=user_id, text=f"🤩🤩 تم إنشاء الحساب بنجاح 🎉🎉\n- اسم المستخدم : {req['ech_user']}\n- كلمة المرور : {req['ech_pass']}")
                elif req["type"] == "charge_echancy":
                    amt = req["amount"]
                    users[user_id]["balance"] -= amt
                    save_data()
                    await context.bot.send_message(chat_id=user_id, text="تم شحن حسابك بنجاح ✅")
                elif req["type"] == "withdraw_echancy":
                    amt = req["amount"]
                    users[user_id]["balance"] += amt
                    save_data()
                    await context.bot.send_message(chat_id=user_id, text=f"تم السحب بنجاح رصيدك بالبوت هو {users[user_id]['balance']}")
                elif req["type"] == "loyalty_exchange":
                    pts_deducted = req["points"]
                    reward_desc = req.get("reward_desc", "250")
                    users[user_id]["loyalty_points"] -= pts_deducted
                    if reward_desc == "250":
                        users[user_id]["balance"] += 250
                    save_data()
                    await context.bot.send_message(chat_id=user_id, text=f"- تهانينا 🎉🎉🎉 لقد حصلت على جائزة تبديل نقاط الولاء: ({reward_desc})")
                await query.message.edit_text("✅ تمت الموافقة على الطلب.")
            else:
                pending_requests.pop(req_id, None)
                save_data()
                await context.bot.send_message(chat_id=user_id, text="❌ عذراً، تم رفض طلبك من قبل الإدارة.")
                await query.message.edit_text("❌ تم رفض الطلب.")

